# Site URL (used for SEO metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Optional in local dev — graceful fallback to src/data/seed-data.ts when unset)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Restricts /admin & /api/admin/* access to this Supabase Auth account email
ADMIN_EMAIL=zidanseftino18@gmail.com

# Resend (Optional — sends contact form notifications to your email)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
CONTACT_TO_EMAIL=zidanseftino18@gmail.com

# GitHub (Optional — enables 12-month Contribution Calendar heatmap & raises API limit to 5000/hr; use Classic PAT with 'read:user' scope)
GITHUB_TOKEN=
